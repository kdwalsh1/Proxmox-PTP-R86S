# Generated by setup.sh - copy to .env and fill in, or let setup.sh do it for you.

# Base URL of the host ptp-agent API, reachable from this container over vmbr0.
AGENT_URL=http://192.0.2.1:8081

# Shared token from /etc/ptp-webui/agent.token on the Proxmox host.
AGENT_TOKEN=

# bcrypt/argon2 hash from password_hash(), used for the single admin login.
ADMIN_PASSWORD_HASH=

# Random secret (not currently used for signing, reserved for future use).
APP_SESSION_SECRET=
